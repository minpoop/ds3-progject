{
  "sheet": "hooks",
  "doc": "One row per Windows function the hook DLL intercepts inside the game process. Each row generates one detour function and one install entry (tools/gen.py). Actions: redirect_paths (rewrite paths under the real save folder to the private copy), deny_addr (refuse non-loopback socket addresses), deny_name (refuse non-local host names), custom (hand-written in crates/hook/src/custom.rs).",
  "columns": {
    "id": {
      "type": "id"
    },
    "system": {
      "type": "ref",
      "sheet": "systems"
    },
    "module": {
      "type": "string",
      "doc": "DLL that exports the function"
    },
    "function": {
      "type": "string",
      "doc": "exported name"
    },
    "args": {
      "type": "list",
      "doc": "'name:RustType' in call order"
    },
    "ret": {
      "type": "string",
      "doc": "Rust return type"
    },
    "action": {
      "type": "enum",
      "values": [
        "redirect_paths",
        "deny_addr",
        "deny_name",
        "custom"
      ]
    },
    "target_args": {
      "type": "intlist",
      "min": 0,
      "doc": "argument indexes the action looks at (paths, or the socket address / host name); empty for custom hooks"
    },
    "name_kind": {
      "type": "enum",
      "values": [
        "none",
        "utf16",
        "ansi"
      ],
      "doc": "encoding of the host name for deny_name"
    },
    "deny_ret": {
      "type": "string",
      "doc": "Rust expression returned when denied ('none' if the action never denies)"
    },
    "error_api": {
      "type": "enum",
      "values": [
        "none",
        "wsa",
        "win32"
      ],
      "doc": "which API sets the last error when denying"
    },
    "deny_error": {
      "type": "int",
      "doc": "error code set when denying (0 when none)"
    },
    "custom_fn": {
      "type": "string",
      "doc": "function in custom.rs for action=custom, else 'none'"
    },
    "optional": {
      "type": "bool",
      "doc": "true: skip (log) instead of failing closed when the function does not exist"
    },
    "milestone": {
      "type": "int"
    },
    "fallback_module": {
      "type": "string",
      "doc": "second module to try when the function is not exported by `module` (Windows and Wine put some file APIs in kernel32, others in kernelbase); 'none' if there is no fallback"
    }
  },
