{
  "sheet": "files",
  "doc": "Every file or folder the mashup reads or writes. 'guarded' means it must never be modified by the mashup; tests assert it.",
  "columns": {
    "id": {
      "type": "id"
    },
    "path": {
      "type": "string",
      "doc": "root token + path; see design/README.md"
    },
    "purpose": {
      "type": "string"
    },
    "access": {
      "type": "enum",
      "values": [
        "read",
        "write",
        "readwrite"
      ]
    },
    "system": {
      "type": "ref",
      "sheet": "systems"
    },
    "guarded": {
      "type": "bool"
    },
    "milestone": {
      "type": "int"
    }
  },
  "rows": [
    {
      "id": "real_save_dir",
      "path": "{appdata}/DarkSoulsIII",
      "purpose": "The player's real Dark Souls III saves: read for the copy and the hash check only; restored from backup if it ever changes",
      "access": "read",
      "system": "save_backup_verify",
      "guarded": true,
      "milestone": 1
    },
    {
      "id": "real_save_backup",
      "path": "{data}/backups",
      "purpose": "Full copy of the real save taken before each launch (newest three kept)",
      "access": "write",
      "system": "save_backup_verify",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "sandbox_save_dir",
      "path": "{data}/save/DarkSoulsIII",
      "purpose": "The mashup's private copy of the save; the game's save folder is redirected here",
      "access": "readwrite",
      "system": "save_sandbox_copy",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "ds3_exe",
      "path": "{game}/Game/DarkSoulsIII.exe",
      "purpose": "The game; started only through ModEngine2, never modified",
      "access": "read",
      "system": "me2_launch",
      "guarded": true,
      "milestone": 1
    },
    {
      "id": "me2_launcher",
      "path": "{me2}/modengine2_launcher.exe",
      "purpose": "ModEngine2's launcher, installed by Melty",
      "access": "read",
      "system": "me2_launch",
      "guarded": true,
      "milestone": 1
    },
    {
      "id": "me2_dll",
      "path": "{me2}/modengine2/bin/modengine2.dll",
      "purpose": "ModEngine2's injected library, installed by Melty",
      "access": "read",
      "system": "me2_launch",
      "guarded": true,
      "milestone": 1
    },
    {
      "id": "me2_config",
      "path": "{data}/config/config_ashenmarine.toml",
      "purpose": "ModEngine2 config generated before every launch: our hook DLL and mod folder",
      "access": "write",
      "system": "me2_launch",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "hook_config",
      "path": "{data}/config/ashenmarine.json",
      "purpose": "Generated before every launch: tells the hook DLL the real and private save folders and the log path",
      "access": "write",
      "system": "save_redirect",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "hook_dll_file",
      "path": "{data}/ashenmarine_hook.dll",
      "purpose": "The hook DLL ModEngine2 loads into the game",
      "access": "read",
      "system": "me2_launch",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "mod_dir",
      "path": "{data}/mod",
      "purpose": "ModEngine2 mod folder (loose game-file overrides); empty in milestone 1",
      "access": "read",
      "system": "me2_launch",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "hook_log",
      "path": "{data}/logs/hook.log",
      "purpose": "What the hook DLL did this session",
      "access": "write",
      "system": "hook_logging",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "launcher_log",
      "path": "{data}/logs/launcher.log",
      "purpose": "What the launcher did this session",
      "access": "write",
      "system": "hook_logging",
      "guarded": false,
      "milestone": 1
    },
    {
      "id": "sm2_install",
      "path": "{sm2}",
      "purpose": "The player's Space Marine 2 install: read-only, never written, never launched",
      "access": "read",
      "system": "sm2_read",
      "guarded": true,
      "milestone": 2
    },
    {
      "id": "converted_assets",
      "path": "{data}/assets",
      "purpose": "SM2 content converted on the player's PC; private, never uploaded or committed",
      "access": "write",
      "system": "asset_convert",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "probe_ds3_files",
      "path": "{data}/logs/probe-ds3.txt",
      "purpose": "What the read-only game probe found (also probe-ds3-weapons.csv, -goods.csv, -inventory.csv, -samples.csv, -text-*.csv next to it)",
      "access": "write",
      "system": "ds3_probe",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "sm2_probe_out",
      "path": "{data}/probe-sm2",
      "purpose": "The setup tool's probe report and texture preview pictures (private; made from the player's own install)",
      "access": "write",
      "system": "sm2_probe",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "sm2_folder_hint",
      "path": "{data}/sm2-folder.txt",
      "purpose": "Optional: the player's Space Marine 2 folder on its first line, when it is not in a normal Steam library",
      "access": "read",
      "system": "sm2_discovery",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "assets_sounds_dir",
      "path": "{data}/assets/sounds",
      "purpose": "WAV files made on the player's PC from their own Space Marine 2 sound files (private; never uploaded or committed)",
      "access": "write",
      "system": "asset_convert",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "assets_ready",
      "path": "{data}/assets/ready.json",
      "purpose": "Written last by the setup tool: says the conversion finished and what it made",
      "access": "write",
      "system": "asset_convert",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "prepare_report",
      "path": "{data}/prepare-sm2/prepare-report.txt",
      "purpose": "What the setup tool converted, with the sound-container trees it followed (private)",
      "access": "write",
      "system": "asset_convert",
      "guarded": false,
      "milestone": 2
    },
    {
      "id": "sounds_index",
      "path": "{data}/assets/sounds/index.json",
      "purpose": "Lists the sound slots and their WAV files; read by the hook DLL when the game starts",
      "access": "read",
      "system": "weapon_sound",
      "guarded": false,
      "milestone": 3
    },
    {
      "id": "ds3_archives",
      "path": "{game}/Game",
      "purpose": "Dark Souls III's own archives (Data*.bhd, Data*.bdt, DLC*.bhd/.bdt), opened read-only by ds3-probe and ds3-prepare to read the item text; nothing in this folder is ever changed",
      "access": "read",
      "system": "item_names",
      "guarded": true,
      "milestone": 3
    },
    {
      "id": "ds3_prepare_report",
      "path": "{data}/ds3-prepare/ds3-report.txt",
      "purpose": "What ds3-probe / ds3-prepare found in the game's archives and what they wrote (private; key fingerprints only, no keys)",
      "access": "write",
      "system": "item_names",
      "guarded": false,
      "milestone": 3
    },
    {
      "id": "msg_override_item",
      "path": "{data}/mod/msg/ENGLISH/item.msgbnd.dcx",
      "purpose": "Loose copy of the game's item text with the test weapons' names, picked up by ModEngine2 instead of the archived file",
      "access": "write",
      "system": "item_names",
      "guarded": false,
      "milestone": 3
    },
    {
      "id": "msg_override_manifest",
      "path": "{data}/mod/ashenmarine-msg.json",
      "purpose": "Which source text the override was made from (hashes) and what it changed, so a stale override is noticed",
      "access": "write",
      "system": "item_names",
      "guarded": false,
      "milestone": 3
    },
    {
      "id": "ds3_key_cache",
      "path": "{data}/cache/ds3-keys.pem",
      "purpose": "Only if the exe does not hold the archive keys as plain text: the public RSA keys the running game has in memory, written by the test kit's probe so ds3-prepare can use them",
      "access": "readwrite",
      "system": "item_names",
      "guarded": false,
      "milestone": 3
    }
  ]
}
